.battle-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    /* Solid — this must read as a real scene cut, not a HUD floating over the paused overworld.
       BattleManager also disables the overworld camera while a battle is active; this backdrop
       is the visual belt-and-suspenders in case anything else ever renders behind the panel.
       Placeholder arena color only — real diorama art is still "pending art direction" per
       Combat_Directive_v0_1_0.md. */
    background-color: rgb(24, 20, 26);
}

/* Sonny 2-style layout: top HP/Aura list per side, middle stage with placeholder creature
   circles (player left, enemy right, same lane — no visible lane graphics; see
   BattleStageGizmos.cs for the Scene-view-only dev visualization of the 7 lane positions), and a
   bottom row inside the stage with the current-action panel on the left and the battle log on the
   right. */

/* Absolutely positioned over the stage rather than a normal flex-column sibling of it (2026-08-06,
   user-directed — see DECISIONS.md -> [Combat]: adding a 3rd party member visibly moved the
   ENEMY too, because .status-header's height was growing with each new .status-row and .stage
   (flex-grow: 1, same flex-column parent) was shrinking to compensate — .stage-side's `top: %`
   anchors then resolved to a different absolute pixel position any time party size changed, even
   though nothing about the enemy itself had changed. Taking status-header out of flex flow makes
   .stage always fill the FULL battle-root height regardless of party size, so stage-side's anchor
   point is now a fixed px offset (see .stage-side below) — stable no matter how many rows are
   shown. */
.status-header {
    position: absolute;
    /* Pushed down from 0 (2026-08 follow-up — user report: "getting covered by the top") — the
       overworld's DebugMovementPresetCycler text renders at screen (0,0) and BattleScene_Main
       loads additively ON TOP of the overworld (both scenes stay active during battle, see
       BattleTransition's doc comment), so that debug overlay was bleeding through and covering
       the nameplate's name/top edge. 28px clears its ~2 lines of text with margin to spare. */
    top: 28px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: space-between;
    padding: 8px;
}

/* Fixed narrow sidebar, not the old 33%-of-screen row list — the radial nameplate below doesn't
   need that much width, and a narrower sidebar leaves clean horizontal separation from the
   staged creatures (anchored around the 20%/80% marks — see .stage-side below), no matter how
   tall the sidebar grows stacking nameplates. */
.status-list {
    flex-direction: column;
    width: 160px;
}

.status-list-enemy {
    align-items: flex-end;
}

/* Radial nameplate (2026-08-06, user-directed — see DECISIONS.md -> [Combat]: replaces the old
   stacked HP/Aura/Burst bars with a circular gauge around a portrait, "so its cleaner and more
   straight forward"). Deliberately an INVISIBLE container — no background, no border — per the
   user's explicit ask: "an invisible container that this hud sits in, so when you have to stack
   multiple of these huds together... you can just stack the full containers side by side." Every
   sub-element (name, ring, stats, buff row) lives inside this one self-contained box; stacking N
   of them (up to MaxNameplateSlots — see BattleHUDController) is just N containers in a column,
   nothing about one depends on its neighbors. Fixed width matching .status-list so the buff row
   below has a stable wrap boundary. */
/* Sized to fit MaxNameplateSlots (7) stacked in the available header height without overlapping
   the bottom row (2026-08-06 — verified live, first pass at 64px rings/12px name overflowed past
   7 slots into the Battle Log panel; shrunk across the board here). */
.nameplate {
    width: 160px;
    padding: 2px;
    margin-bottom: 3px;
}

.nameplate-name {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 10px;
    -unity-text-align: middle-center;
    margin-bottom: 1px;
}

/* Square mount for RadialGaugeVisual (a custom Painter2D element, not a UXML-declared child —
   see BattleHUDController.BuildNameplate) plus the portrait circle it draws around. Both are
   centered in this box and share its exact size, so RadialGaugeVisual's own resolvedStyle-based
   radius math always matches where the portrait actually sits. */
.nameplate-ring-wrap {
    position: relative;
    width: 46px;
    height: 46px;
    margin: 0 auto 2px;
}

.nameplate-portrait {
    position: absolute;
    width: 24px;
    height: 24px;
    left: 11px;
    top: 11px;
    border-radius: 12px;
    background-color: rgb(140, 140, 150);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.4);
}

.nameplate-gauge {
    position: absolute;
    left: 0;
    top: 0;
    width: 46px;
    height: 46px;
}

.nameplate-stats {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 1px;
}

.nameplate-stat {
    font-size: 7px;
    margin-right: 4px;
    -unity-text-align: middle-center;
}

.nameplate-stat-hp {
    color: rgb(90, 200, 100);
}

.nameplate-stat-aura {
    color: rgb(90, 140, 230);
}

.nameplate-stat-evo {
    color: rgb(150, 90, 220);
    margin-right: 0;
}

/* Bars-style nameplate mockup (2026-08 follow-up — user asked for the HP/Aura/Evo readout as "3
   horizontal rectangles stacked vertically" with current/total shown on hover, instead of the
   circular gauge; see BattleHUDController.ActiveNameplateStyle for the toggle and
   NameplateRefs/BuildNameplate for why the Radial classes above are all still intact, not deleted
   — the user explicitly asked to keep the circular version available to switch back to). Static
   sizing only (no per-count interpolation like the Radial constants above) — first-pass mockup,
   not yet tuned against a battle with more than the current 3-member party. */
.nameplate-name-bars {
    font-size: 14px;
}

.nameplate-bars-wrap {
    flex-direction: column;
    align-items: center;
    margin-bottom: 2px;
}

/* Unity USS doesn't support :last-child, so the final row's margin-bottom isn't specially
   suppressed — absorbed by .nameplate-bars-wrap's own margin-bottom below instead of mattering. */
.nameplate-bar-row {
    margin-bottom: 4px;
}

.nameplate-bar-track {
    position: relative;
    width: 140px;
    height: 18px;
    background-color: rgba(20, 20, 24, 0.85);
    border-width: 1px;
    border-color: rgb(70, 70, 75);
    border-radius: 3px;
    overflow: hidden;
}

.nameplate-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
}

.nameplate-bar-hp .nameplate-bar-fill {
    background-color: rgb(90, 200, 100);
}

.nameplate-bar-aura .nameplate-bar-fill {
    background-color: rgb(90, 140, 230);
}

.nameplate-bar-evo .nameplate-bar-fill {
    background-color: rgb(150, 90, 220);
}

/* .nameplate-bar-evo-ready itself carries no background-color rule — tried that first (compound
   selector .nameplate-bar-fill.nameplate-bar-evo-ready, matching the descendant rule above's
   2-selector specificity), but the descendant rule kept winning regardless of source order when
   verified live, so BattleHUDController.ApplyEvoVisual sets the ready/filling color as an
   explicit INLINE style instead (always wins over any stylesheet rule — sidesteps the ambiguity
   entirely). This class still gets added/removed on the fill element purely so other code can
   query "is this ready" via GetClasses() without needing to compare resolvedStyle colors. */

/* Evo-ready flashing perimeter (2026-08 follow-up — user-directed: "highlighting the perimeter
   of the evo box and have it flash lightly" — there was previously no attention-grabbing signal
   that Evolution Burst could be activated). Applied to the TRACK (not the fill, which already
   goes solid gold via ApplyEvoVisual's inline style, see above) — BattleHUDController.
   ApplyEvoVisual adds .nameplate-bar-evo-track-ready once, then toggles .nameplate-bar-evo-flash
   on/off via a repeating schedule (EvoFlashIntervalMs) for as long as the gauge stays ready,
   alternating the border between two gold shades for a light flash rather than a jarring blink. */
.nameplate-bar-evo-track-ready {
    border-color: rgb(230, 210, 60);
    border-width: 2px;
}

.nameplate-bar-evo-track-ready.nameplate-bar-evo-flash {
    border-color: rgb(255, 245, 190);
}

/* Buff/debuff row — deliberately its own full-width row below the stats, NOT squeezed next to
   the name (2026-08-06, user-directed: "we'll be putting a lot so keeping it underneath makes
   sense so you can just stack from left to right"). flex-wrap means once a row fills the
   nameplate's width it starts a second row on its own — no extra logic needed as more buffs get
   added later. */
.nameplate-buffs {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* Sized up from the original 12px (2026-08 follow-up — user-directed: "the icons for buffs and
   debuffs are too smaller, please increase the size") — Bars-style nameplates never run
   ApplyNameplateSize's dynamic Comfortable/Compact lerp (see that method's own early-return doc
   comment), so these were stuck at the Radial style's smallest ("Compact", 7-slot) tier
   permanently. 20px reads clearly at the nameplate's current fixed size. */
.nameplate-buff-icon {
    display: none;
    position: relative;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    margin: 0 4px 3px 0;
}

.nameplate-buff-regen {
    background-color: rgb(90, 60, 120);
    border-color: rgb(190, 140, 230);
}

.nameplate-buff-burst {
    background-color: rgb(140, 85, 30);
    border-color: rgb(240, 170, 90);
}

/* Generic status-effect (debuff/buff) icon colors, one per StatusEffectCategory (2026-08
   follow-up — user report: no debuff indicator appeared on the enemy nameplate after a
   status-applying skill; BattleHUDController.RefreshStatusIcons is the fix). Placeholder colors,
   not GDD-locked — distinct from Regen's purple/Burst's orange so all 4 possible icon slots stay
   visually separable. Applied via EnableInClassList-equivalent add/remove in
   BattleHUDController.RefreshStatusIcons, same convention as .skill-ring-color-N. */
.nameplate-status-physical {
    background-color: rgb(130, 45, 45);
    border-color: rgb(220, 120, 120);
}

.nameplate-status-elemental {
    background-color: rgb(30, 110, 130);
    border-color: rgb(120, 200, 220);
}

.nameplate-status-signal {
    background-color: rgb(75, 60, 140);
    border-color: rgb(150, 140, 220);
}

.nameplate-status-universal {
    background-color: rgb(80, 80, 85);
    border-color: rgb(165, 165, 170);
}

.nameplate-status-positive {
    background-color: rgb(50, 120, 60);
    border-color: rgb(140, 220, 150);
}

.nameplate-buff-icon-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}

.nameplate-buff-icon-counter {
    position: absolute;
    right: -3px;
    bottom: -11px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.stage {
    flex-grow: 1;
    position: relative;
}

/* Creatures sit in the upper portion of the stage (not dead-center) so the bottom row (action
   panel + battle log) has clear room below without overlapping them. Each side is anchored at
   1/5 of the screen width in from its edge, translated back by half its own size so the anchor
   point is the group's center, not its corner. `top` is a fixed px offset, NOT a percentage
   (2026-08-06, user-directed — see DECISIONS.md -> [Combat]) — .stage now always fills the full
   battle-root height (status-header is absolutely positioned, out of flow — see that comment), so
   a fixed px clears the header with margin to spare regardless of party size, instead of a
   `top: 30%` that used to resolve to a different pixel position every time the header's content
   height changed. */
.stage-side {
    position: absolute;
    /* 480px -> 500px -> 480px (2026-08-12, user: "move the lanes down more" then, after
       LaneRowHeightPx was reduced ~15% freed up room again, "move the L1 up by about 20px" —
       see DECISIONS.md -> [Combat]). Net result lands back on the original anchor value, but for
       a different reason each time — not a no-op revert, the row size changed in between. */
    top: 480px;
    flex-direction: row;
    align-items: center;
}

.stage-side-player {
    left: 20%;
    translate: -50% -50%;
}

.stage-side-enemy {
    right: 20%;
    translate: 50% -50%;
    flex-direction: row-reverse;
}

/* Absolutely positioned (not flex-flowed) so BattleHUDController can freely reorder player
   creatures for paint order (BringToFront, for "selected wheel always on top" — see
   DECISIONS.md -> [Combat], 2026-08-06 layering fix) WITHOUT that reorder also moving them
   within the row — a flex-flowed child's document position IS its layout position, so
   BringToFront on a flex child used to visibly shove it to a different spot. left/top are set
   per-instance in C# (BattleHUDController.LayoutPlayerStageCreatures) at 128px column spacing
   (72 width + 28+28, same visual gap the old margin-left/right produced), anchored/compacted
   to however many party members are actually present this battle. Also sets up "place each
   Phasix at an explicit position" for a future formation/positioning feature (deferred — see
   DECISIONS.md) — anchoring the pair where they are now is a placeholder, not the final say on
   where a creature can stand. */
.stage-creature {
    position: absolute;
    top: 0;
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: rgb(140, 140, 150);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.4);
    opacity: 1;
}

/* Sonny 2-style move selection (2026-08-05/06, user-directed — see DECISIONS.md -> [Combat]):
   small round icon badges floating further out from the acting player's stage creature at fixed
   clock-face positions instead of a boxed menu, matching Sonny 2's own circular ability-icon
   reference (plain circle, minimal text, no description needed). Five placeholders exist now —
   "A" (Attack, green, 1 o'clock) and "K" (Capture, gold via .move-option-gold, 3 o'clock,
   2026-08-06 Phase 3 Gate wiring): click-drag onto an ENEMY. "C" (Charge, blue, 11 o'clock), "H"
   (Heal, pink, 12 o'clock), and "R" (Regen, purple via .move-option-purple, 2 o'clock) are all
   solo/self-only skills: same click-drag gesture as Attack, but the only valid drop target is the
   CASTER's own creature ("this one happens to only make it so you can select the character that
   is casting it") — releasing anywhere else cancels back to the placeholders, same as Attack.
   "C" restores Aura instantly; "H" spends Aura for an instant HP heal; "R" spends Aura for an
   over-time heal that ticks at the end of the player's turn (see BattleManager.TickPlayerRegen
   and the .status-bar icon below); "K" attempts CaptureSystem's placeholder chance-roll, ending
   the battle on success. All five go through BattleHUDController.BeginDrag/OnDragPointerUp
   (MoveOptionIsSelfOnly, index-matched to this array, decides the valid drop target per move —
   not a per-move enum/switch, so adding a 6th move needs no new branch here) — none is a full
   Button, so pointer-down doesn't fight the drag for pointer capture. BattleHUDController
   computes each option's left/top per-instance (PositionMoveOptions, using MoveOptionRadius for
   the distance from the creature) — this class only supplies the fixed visual size/style, not
   position. */
.move-option-placeholder {
    position: absolute;
    width: 32px;
    height: 32px;
    background-color: rgb(60, 110, 65);
    border-width: 3px;
    border-color: rgb(140, 230, 150);
    border-radius: 16px;
}

/* Second orb ("C", Charge) — blue instead of green, per the user's explicit "make one blue and the other green." */
.move-option-blue {
    background-color: rgb(50, 85, 120);
    border-color: rgb(130, 190, 240);
}

/* Third orb ("H", Heal) — pastel pink. Solo/self-only skill — costs HealAuraCost Aura, heals
   HealAmount HP instantly on cast (see BattleManager.PlayerTurn's MoveOptionHeal branch). */
.move-option-pink {
    background-color: rgb(150, 90, 115);
    border-color: rgb(240, 170, 200);
}

/* Fourth orb ("R", Regen, 2026-08-06 addition) — purple. Solo/self-only skill — costs
   RegenAuraCost Aura, heals RegenHealPerTurn HP at the end of the player's turn for
   RegenDurationTurns turns (see BattleManager.TickPlayerRegen). Same purple, smaller, is reused
   for the .status-icon-purple buff icon below while the status is active. */
.move-option-purple {
    background-color: rgb(90, 60, 120);
    border-color: rgb(190, 140, 230);
}

/* Fifth orb ("K", Capture, 2026-08-06 Phase 3 Gate wiring) — gold. NOT self-only — targets the
   ENEMY like Attack (see BattleHUDController.MoveOptionIsSelfOnly). Attempts CaptureSystem's
   placeholder chance-roll; success ends the battle and adds the enemy to the party. */
.move-option-gold {
    background-color: rgb(120, 100, 40);
    border-color: rgb(230, 200, 90);
}

/* Absolute-fills the parent circle with centered text rather than relying on flex centering —
   guarantees the letter is dead-center regardless of the Label's own default box/alignment
   quirks (2026-08-05, user-directed: "make sure the letters are centered on the orb"). The first
   pass at this still rendered off-center because Unity's default runtime theme applies a
   non-zero, ASYMMETRIC margin/padding to every Label (measured live: margin 2/4/4/2,
   padding 1/2/4/4 px, left/right/top/bottom) — with left:0/right:0/top:0/bottom:0 alone, that
   margin still shifts the box right+down inside the 0-inset rect. margin:0 and padding:0 here
   are load-bearing, not decorative (2026-08-06 fix — see DECISIONS.md -> [Combat]). */
.move-option-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 13px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
}

/* "Already acted this turn" state (2026-08-06, user-directed — see DECISIONS.md -> [Combat]:
   "if the phasix already moved during its turn then it can still show, but will be greyed out
   for active skills") — BattleHUDController.ShowMoveSelectionReadOnly applies this to every orb
   in the wheel; BeginDrag refuses to start a drag for a read-only slot, so this is a genuine
   disabled state, not just a visual one. */
.move-option-disabled {
    opacity: 0.35;
}

/* Persistent Move icon (2026-08-12 redesign) — a small always-present badge on every player stage
   creature's top-right corner, deliberately NOT reusing any of the 5 ring-orb colors above (all
   already claimed: green=Attack, blue=Charge, pink=Heal, purple=Regen, gold=Capture) — teal reads
   as "not a skill," matching the redesign's intent that Move is a different kind of action.
   BattleHUDController parents this directly under the 72px .stage-creature so it inherits every
   ApplyLaneLayout position/scale change automatically. */
.move-icon {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgb(50, 110, 110);
    border-width: 2px;
    border-color: rgb(120, 220, 220);
}

/* "Already acted" / not-your-turn state — mirrors .move-option-disabled. SetMoveIconVisible fully
   hides the icon instead of using this for the common case (turn hasn't started / already acted),
   kept as a distinct class in case a future "visible but temporarily unusable" state needs it. */
.move-icon-disabled {
    opacity: 0.35;
}

/* Stage-aligned position markers (2026-08-12 redesign) — the in-battle Move-drag target set,
   BattleHUDController.ShowStagePositionMarkers. Reuses .formation-grid-cell's exact look (see
   below) via FormationGridPicker.BuildCell, but each marker is individually absolute-positioned to
   the real stage coordinates (LaneMovementSystem.GetLaneScreenTop/GetPositionOffsetPx) rather than
   flex-flowed into rows/columns — .stage-position-markers is just a plain full-size container,
   not a grid/flex layout itself.
*/
.stage-position-markers {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Skill slot ring (2026-08-06, user-directed — see DECISIONS.md -> [Combat]): 12 dark grey
   circles distributed one per clock hour around the acting creature, on the SAME radius path as
   "A"/"C"/"H"/"R"/"K" (.move-option-placeholder, MoveOptionRadius) — user preferred that original
   spacing over a separate outer ring. Deliberately the SAME size as .move-option-placeholder too
   (2026-08-06 follow-up — user clarified the model: these 12 are the slots, and "A"/"C"/"H"/"R"/
   "K" are skills already SLOTTED INTO the 1/11/12/2/3 o'clock positions, not a smaller decoration
   peeking out from behind a bigger orb) — 5 sit under the built-in moves, the other 7 (hours
   4-10) are real equipped-skill slots as of the 2026-08 Combo/Status/Chain/Mastery wiring session
   (BattleHUDController.PopulateSkillRing/SkillRingSlotOffset/SkillRingSlotCount) — colored per
   the caster's PrimalType same as the stage creature (no per-skill icon exists yet, real skill
   content is still "taxonomy locked, individual skills pending" per CLAUDE.md), draggable exactly
   like the built-in moves. BattleHUD.uxml orders the skill slots BEFORE the move options so
   "A"/"C"/"H"/"R"/"K" paint on top and fully cover the grey slot underneath at those five
   positions. BattleHUDController computes each slot's left/top per-instance (PositionSkillSlots)
   — this class only supplies the fixed visual size/style. Shown/hidden together with the move
   options (SetMoveOptionsVisible). */
.skill-slot-placeholder {
    position: absolute;
    width: 32px;
    height: 32px;
    background-color: rgb(45, 45, 50);
    border-width: 3px;
    border-color: rgb(80, 80, 85);
    border-radius: 16px;
}

/* Applied to a real skill-ring slot (hours 4-10) that this creature has no equipped skill in —
   dimmed, matches .skill-slot-placeholder's own empty-grey look but explicitly flagged so a
   populated slot (which gets no extra class) is visually distinct once skills exist to compare
   against. 2026-08 session, see DECISIONS.md -> [Combat]. */
.skill-slot-locked {
    opacity: 0.4;
}

/* .skill-ring-color-0..6 (the old per-ring-position ring palette) removed 2026-08-09 — the battle
   skill ring's fill/border color is now applied inline by the shared SkillTreeColor.ApplyVisual
   (Assets/Scripts/Combat/SkillTreeColor.cs), same source the Party menu's skill web and equip
   wheel use, so all three can never show a different color for the same skill again. See
   DECISIONS.md -> [Combat] for the full rationale. */

/* Skill-wheel combo-streak counter (2026-08 session — user-directed: "counter next to the skill
   on the skill wheel," see DECISIONS.md -> [Combat]). Styled as its own small solid-circle badge
   — same ICON-shaped language as .nameplate-buff-icon (a colored circle with a bold centered
   glyph), not a bare floating subscript — user found the original tiny text-only version too hard
   to read. Sized up from the nameplate's 12px buff icon since the skill slot itself (32px) is
   much bigger than a nameplate. Pushed out to a clearly separate radius from the orb (right/
   bottom: -14px, versus the first icon pass's -4px, which still visually touched the orb's edge)
   per user follow-up — reads as its own distinct marker next to the orb, not an overlapping
   corner tag. BattleHUDController.SetSkillComboCounter/ClearAllSkillComboCounters own its
   text/visibility — this class is fixed-position styling only. pickingMode is Ignore in code so
   it never intercepts the skill slot's own drag click. */
.skill-combo-badge {
    position: absolute;
    right: -14px;
    bottom: -14px;
    width: 16px;
    height: 16px;
    margin: 0;
    padding: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(230, 150, 230);
    background-color: rgb(200, 60, 200);
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

/* Shared runtime hover tooltip (2026-08 follow-up fix — see BattleHUDController._hudTooltip's
   doc comment: UI Toolkit's native VisualElement.tooltip never renders in a runtime UIDocument
   panel, only inside Editor-hosted UI, so the original "richer hover tooltip" pass silently never
   worked in Play Mode or a build). One shared Label, shown/hidden/repositioned per-frame off
   pointer events rather than a per-source element — position is set inline in C#
   (PositionHudTooltip), this class supplies fixed visual styling only. pickingMode is Ignore in
   code so it never intercepts whatever's underneath it (a skill orb, a nameplate bar). Used by
   both the skill-ring orbs and the nameplate HP/Aura/Evo bars (see .nameplate-bar-track below). */
.hud-tooltip {
    position: absolute;
    max-width: 220px;
    padding: 6px 8px;
    background-color: rgba(10, 10, 14, 0.95);
    border-width: 2px;
    border-color: rgb(90, 90, 100);
    border-radius: 6px;
    font-size: 13px;
    color: rgb(230, 230, 235);
    white-space: normal;
}

/* Converging-ring action-command timing (2026-08-05, user-directed, Sonny 2-referenced — see
   DECISIONS.md -> [Combat]): shared by both RunTimedInput (offense, reparented above the
   TARGETED enemy) and RunDefenseTimedInput (defense, reparented above the defending player
   creature) — replaces the old horizontal timing bar entirely. RingVisual draws itself via
   Painter2D — see that class. pickingMode is Ignore on the element itself; sized generously so
   the full-radius ring always fits inside its own layout box. */
.timing-ring {
    position: absolute;
    top: -150px;
    left: 50%;
    translate: -50% 0;
    width: 140px;
    height: 140px;
}

/* Multi-Hit Volley (2026-08-14) — unlike .timing-ring above, position is set per-instance in C#
   (BattleHUDController.PositionVolleyRing), since up to 8 of these can be open at once, each at a
   different compass offset around the target. No top/left/translate here. */
.timing-ring-volley {
    position: absolute;
    width: 140px;
    height: 140px;
}

/* Bottom row: action panel (current turn/move/timing bar) fills the left half of the screen,
   battle log fills the right half — each panel is flex-grow:1/flex-basis:0 so the row's full
   width (left:0/right:0, edge-to-edge) splits exactly 50/50, with only a small gap-via-margin
   between them. Height is fixed (150px, halved from 300px 2026-08-06 — user-directed: "make the
   battle log and notif menu to be about 50% of its current height so theres more room") on both,
   unrelated to the width split. */
.stage-bottom-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    flex-direction: row;
    align-items: flex-start;
}

.action-panel {
    flex-grow: 1;
    flex-basis: 0;
    height: 150px;
    margin-right: 8px;
    padding: 10px;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 10, 14, 0.9);
    border-width: 2px;
    border-color: rgb(90, 90, 100);
}

.turn-label {
    font-size: 18px;
    color: rgb(230, 230, 230);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

/* Action announcement — text-only now (Combat_Directive_v0_1_0.md Part 4's action-command label).
   Both the offensive and defensive timing checks moved entirely to the converging RingVisual
   (2026-08-05, user-directed — see DECISIONS.md -> [Combat] and .timing-ring above); this panel
   just shows which check is running and on whom, color-coded to match (green = offense, gold =
   defend) so it's still unmistakable at a glance which check the ring belongs to. */
.action-announcement {
    align-items: center;
    padding: 4px;
}

.action-announcement-label {
    -unity-font-style: bold;
}

.action-announcement-offense .action-announcement-label {
    color: rgb(140, 230, 150);
}

.action-announcement-defend .action-announcement-label {
    color: rgb(230, 210, 130);
}

/* Auto-paced beat message (BattleHUDController.ShowTimedMessage) — shown after every beat
   (announcement, resolved attack, turn transition), auto-hiding on a fixed timer with no click
   required. Used to gate on a Continue button (name kept as "continue-prompt"/"ContinuePrompt"
   rather than renamed, to minimize churn — see DECISIONS.md -> [Combat]) until the user judged
   the extra click unnecessary (2026-08-06). */
.continue-prompt {
    align-items: center;
    padding: 6px;
}

/* Text battle log — damage dealt, Primal type effectiveness, timed-input results. */
.battle-log-panel {
    flex-grow: 1;
    flex-basis: 0;
    height: 150px;
    margin-left: 8px;
    padding: 10px;
    background-color: rgba(10, 10, 14, 0.9);
    border-width: 2px;
    border-color: rgb(90, 90, 100);
}

.battle-log-title {
    font-size: 15px;
    color: rgb(210, 210, 220);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.battle-log-scroll {
    flex-grow: 1;
}

.battle-log-entry {
    font-size: 13px;
    color: rgb(230, 230, 235);
    white-space: normal;
    margin-bottom: 5px;
}

/* End Turn button (2026-08-06, user-directed — see DECISIONS.md -> [Combat]: "an end turn
   button thats separate from the dialogue boxes but is clear. Similar to slay the spire 2").
   Deliberately its own distinct, always-there-during-the-player's-turn control — NOT part of
   the ContinuePrompt/ActionAnnouncement dialogue boxes, which the user separately noted are
   "planned to be removed once there is more UI feedback" (this button is not). Sits above the
   bottom row (stage-bottom-row is bottom:20px, 150px tall as of the panel-height halving below)
   so it never overlaps the action panel or battle log. BattleHUDController.SetEndTurnButtonVisible
   toggles it — shown only while the player's turn is active. */
.end-turn-button {
    position: absolute;
    right: 24px;
    bottom: 190px;
    min-width: 160px;
    height: 56px;
    font-size: 24px;
    -unity-font-style: bold;
    background-color: rgb(170, 55, 55);
    color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(230, 120, 120);
    border-radius: 10px;
}

/* Mirrors .end-turn-button on the opposite side (2026-08-10, user-directed) — same size/shape,
   a cool grey-blue instead of red so it doesn't read as "another attack-turn action." */
.flee-button {
    position: absolute;
    left: 24px;
    bottom: 190px;
    min-width: 160px;
    height: 56px;
    font-size: 24px;
    -unity-font-style: bold;
    background-color: rgb(55, 80, 110);
    color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(120, 160, 200);
    border-radius: 10px;
}

/* Formation grid picker (2026-08-12, user: "5 positions across a lane... similar to how the skill
   wheel is set up, but instead a 7 by 5 grid") — FormationGridPicker.cs, shared between the Party
   menu's pre-battle picker and the in-battle Move skill. Lives here (not OverworldMenu.uss) because
   OverworldMenu.uxml already references this file as a second stylesheet — see that file's own
   header comment for why (same reasoning as its shared skill-ring classes). */
.formation-grid {
    align-items: center;
}

.formation-grid-row {
    flex-direction: row;
    justify-content: center;
}

.formation-grid-cell {
    width: 28px;
    height: 28px;
    margin: 2px;
    padding: 0;
    font-size: 12px;
    -unity-text-align: middle-center;
    background-color: rgba(50, 50, 58, 0.9);
    border-width: 1px;
    border-color: rgb(90, 90, 100);
    color: rgb(220, 220, 225);
}

.formation-grid-cell-current {
    background-color: rgba(90, 200, 100, 0.35);
    border-color: rgb(90, 200, 100);
    color: rgb(140, 255, 150);
}

.formation-grid-cell-occupied {
    background-color: rgba(170, 55, 55, 0.35);
    border-color: rgb(170, 55, 55);
    color: rgb(255, 180, 180);
}

/* .formation-grid-title is used by the Party menu's inline formation section
   (OverworldMenuController.BuildFormationSection) — the in-battle equivalent
   (.formation-grid-overlay/-cancel-button, a centered click-to-confirm popup) was REMOVED
   2026-08-12 when Move became a drag-to-real-stage-position action instead (see
   BattleHUDController.ShowStagePositionMarkers/.stage-position-markers below) — no popup, no
   Cancel button, releasing outside every marker is the cancel path. */
.formation-grid-title {
    font-size: 15px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
    margin-bottom: 8px;
}
