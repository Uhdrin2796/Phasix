<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/PartyMenu.uss" />
    <ui:VisualElement name="PartyMenuRoot" class="party-menu-root">
        <ui:Label text="Party — Spend Aura" class="party-menu-title" />
