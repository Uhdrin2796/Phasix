                        <ui:Label text="K" class="move-option-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerStageSlot2" class="stage-creature">
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot0" class="skill-slot-placeholder" />
