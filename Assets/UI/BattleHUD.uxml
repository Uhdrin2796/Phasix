                    <ui:VisualElement name="PlayerSlot2_BurstBack" class="burst-bar-back">
                        <ui:VisualElement name="PlayerSlot2_BurstFill" class="burst-bar-fill" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerSlot2_StatusBar" class="status-bar">
                        <ui:VisualElement name="PlayerSlot2_StatusIcon_Regen" class="status-icon status-icon-purple">
                            <ui:Label text="R" class="status-icon-label" />
                            <ui:Label name="PlayerSlot2_StatusIcon_Regen_Counter" text="" class="status-icon-counter-br" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PlayerSlot2_StatusIcon_Burst" class="status-icon status-icon-orange">
                            <ui:Label text="B" class="status-icon-label" />
                            <ui:Label name="PlayerSlot2_StatusIcon_Burst_Counter" text="" class="status-icon-counter-br" />
