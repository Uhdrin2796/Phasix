<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/BattleHUD.uss" />
    <ui:VisualElement name="BattleHUDRoot" class="battle-root">
        <ui:VisualElement name="Stage" class="stage">
            <ui:VisualElement name="PlayerStageArea" class="stage-side stage-side-player">
                <ui:VisualElement name="PlayerStageSlot0" class="stage-creature">
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot0" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot1" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot2" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot3" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot4" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot5" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot6" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot7" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot8" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot9" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot10" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_SkillSlot11" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot0_MoveOption0" class="move-option-placeholder">
                        <ui:Label text="A" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot0_MoveOption1" class="move-option-placeholder move-option-blue">
                        <ui:Label text="C" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot0_MoveOption2" class="move-option-placeholder move-option-pink">
                        <ui:Label text="H" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot0_MoveOption3" class="move-option-placeholder move-option-purple">
                        <ui:Label text="R" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot0_MoveOption4" class="move-option-placeholder move-option-gold">
                        <ui:Label text="K" class="move-option-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerStageSlot1" class="stage-creature">
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot0" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot1" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot2" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot3" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot4" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot5" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot6" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot7" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot8" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot9" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot10" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_SkillSlot11" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot1_MoveOption0" class="move-option-placeholder">
                        <ui:Label text="A" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot1_MoveOption1" class="move-option-placeholder move-option-blue">
                        <ui:Label text="C" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot1_MoveOption2" class="move-option-placeholder move-option-pink">
                        <ui:Label text="H" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot1_MoveOption3" class="move-option-placeholder move-option-purple">
                        <ui:Label text="R" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot1_MoveOption4" class="move-option-placeholder move-option-gold">
                        <ui:Label text="K" class="move-option-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerStageSlot2" class="stage-creature">
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot0" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot1" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot2" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot3" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot4" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot5" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot6" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot7" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot8" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot9" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot10" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_SkillSlot11" class="skill-slot-placeholder" />
                    <ui:VisualElement name="PlayerStageSlot2_MoveOption0" class="move-option-placeholder">
                        <ui:Label text="A" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot2_MoveOption1" class="move-option-placeholder move-option-blue">
                        <ui:Label text="C" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot2_MoveOption2" class="move-option-placeholder move-option-pink">
                        <ui:Label text="H" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot2_MoveOption3" class="move-option-placeholder move-option-purple">
                        <ui:Label text="R" class="move-option-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerStageSlot2_MoveOption4" class="move-option-placeholder move-option-gold">
                        <ui:Label text="K" class="move-option-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="EnemyStageArea" class="stage-side stage-side-enemy">
                <ui:VisualElement name="EnemyStageSlot0" class="stage-creature" />
            </ui:VisualElement>
            <ui:VisualElement name="StageBottomRow" class="stage-bottom-row">
                <ui:VisualElement name="ActionPanel" class="action-panel">
                    <ui:VisualElement name="ActionAnnouncement" class="action-announcement">
                        <ui:Label name="ActionAnnouncementLabel" text="" class="turn-label action-announcement-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ContinuePrompt" class="continue-prompt">
                        <ui:Label name="ContinuePromptLabel" text="" class="turn-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="BattleLogPanel" class="battle-log-panel">
                    <ui:Label text="Battle Log" class="battle-log-title" />
                    <ui:ScrollView name="BattleLogScrollView" class="battle-log-scroll">
                        <ui:VisualElement name="BattleLogContent" class="battle-log-content" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="EndTurnButton" text="End Turn" class="end-turn-button" />
        </ui:VisualElement>
        <!-- StatusHeader moved AFTER Stage (2026-08 follow-up fix — user report: "all the hover
             over things are not working at all"). .status-header is position:absolute so this
             reorder only changes PAINT/PICK z-order, not layout position — but it matters a lot
             for that: .stage is position:relative/flex-grow:1 and, since .status-header is pulled
             out of flex flow (see .status-header's own comment in BattleHUD.uss), .stage actually
             fills the ENTIRE battle-root, including the screen region the nameplate visually sits
             in. With StatusHeader listed first (original order), .stage — a later sibling —
             painted/picked ON TOP of it across that whole overlap, silently swallowing every
             pointer event meant for the nameplate (hover, and very likely also the pre-existing
             "Evolution Burst gauge not clickable" issue in KNOWN_ISSUES.md's EDITOR-001 — same
             root cause, not Editor degradation as first suspected). Listing StatusHeader last
             makes it the topmost sibling for hit-testing, so nameplate hover/clicks now correctly
             win over .stage's invisible full-screen backdrop. -->
        <ui:VisualElement name="StatusHeader" class="status-header">
            <ui:VisualElement name="PlayerStatusList" class="status-list" />
            <ui:VisualElement name="EnemyStatusList" class="status-list status-list-enemy" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
