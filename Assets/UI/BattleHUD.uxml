                            <ui:Label text="R" class="status-icon-label" />
                            <ui:Label name="PlayerSlot1_StatusIcon_Regen_Counter" text="" class="status-icon-counter-br" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PlayerSlot1_StatusIcon_Burst" class="status-icon status-icon-orange">
                            <ui:Label text="B" class="status-icon-label" />
                            <ui:Label name="PlayerSlot1_StatusIcon_Burst_Counter" text="" class="status-icon-counter-br" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerSlot2" class="status-row">
                    <ui:Label name="PlayerSlot2_Name" text="Ally 3" class="row-name" />
                    <ui:VisualElement name="PlayerSlot2_HPBack" class="hp-bar-back">
                        <ui:VisualElement name="PlayerSlot2_HPFill" class="hp-bar-fill" />
