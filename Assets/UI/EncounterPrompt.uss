.encounter-root {
    position: absolute;
    left: 50%;
    bottom: 20px;
    translate: -50% 0;
    width: 220px;
    padding: 8px;
    background-color: rgba(20, 20, 24, 0.9);
    border-width: 1px;
    border-color: rgb(80, 80, 90);
    align-items: center;
}

.species-name {
    font-size: 14px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.primal-type-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.type-swatch {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}

.type-label {
    font-size: 11px;
    color: rgb(220, 220, 220);
}

.button-row {
    flex-direction: row;
    justify-content: center;
}

.prompt-button {
    min-width: 80px;
    margin-left: 4px;
    margin-right: 4px;
}
